```python
def fibonacci(n: int) -> int:
    """
    Return the n-th Fibonacci number using an iterative approach.

    The sequence is defined as:
        F(0) = 0
        F(1) = 1
        F(n) = F(n - 1) + F(n - 2) for n > 1

    Examples:
        >>> fibonacci(0)
        0
        >>> fibonacci(6)
        8
    """
    if n < 0:
        raise ValueError("n must be a non-negative integer")

    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b

    return a



