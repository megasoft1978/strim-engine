+@Test func gdnPreFusionBatchIndexingAndConvolution() {
+    MLXRandom.seed(20261030)
+    for S in [1, 3, 5, 8] {
+        let B = 4
+        func rnd(_ shape: [Int]) -> MLXArray { (MLXRandom.normal(shape) * 0.5).asType(.bfloat16) }
+        let ci = rnd([B,S+3,10240]), w = rnd([10240,1,4])
+        let a = rnd([B,S,48]), b = rnd([B,S,48]), al = rnd([48]).asType(.float32), dt = rnd([48]).asType(.float32)
+        let batch = GDNPre.run(convIn:ci,weight:w,a:a,b:b,aLog:al,dt:dt)
+        eval(batch)
+        let conv = GDNMetal.convSiluBatch(convIn:ci,weight:w)
+        let referenceV = conv[0...,0...,4096..<10240].reshaped([B,S,48,128])
+        #expect(arrayEqual(batch[2],referenceV).item(Bool.self))
+        #expect(arrayEqual(batch[3],sigmoid(b).asType(.float32)).item(Bool.self))
+        for i in 0..<B {
+            let one = GDNPre.run(convIn:ci[i..<(i+1)],weight:w,a:a[i..<(i+1)],b:b[i..<(i+1)],aLog:al,dt:dt)
+            for j in 0..<5 { #expect(arrayEqual(batch[j][i..<(i+1)],one[j]).item(Bool.self)) }
+        }
+    }
