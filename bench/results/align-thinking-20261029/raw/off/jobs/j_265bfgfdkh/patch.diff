diff --git a/src/server/patch.ts b/src/server/patch.ts
index 7a9b5b8..0768acc 100644
--- a/src/server/patch.ts
+++ b/src/server/patch.ts
@@ -19,6 +19,50 @@ const MAX_TITLE = 40;
  *                                      -> 200 with the stored item, version NOT bumped
  *  6. otherwise store the trimmed fields, bump version by 1 -> 200 with the new item and its new ETag.
  */
+function validatePatch(body: unknown): ItemPatch | null {
+  if (typeof body !== 'object' || body === null || Array.isArray(body)) return null;
+  const o = body as Record<string, unknown>;
+  if (Object.keys(o).length === 0) return null;
+  const out: ItemPatch = {};
+  for (const key of Object.keys(o)) {
+    if (key !== 'title' && key !== 'done') return null;
+  }
+  if ('title' in o) {
+    if (typeof o.title !== 'string') return null;
+    const t = o.title.trim();
+    if (t.length === 0 || t.length > MAX_TITLE) return null;
+    out.title = t;
+  }
+  if ('done' in o) {
+    if (typeof o.done !== 'boolean') return null;
+    out.done = o.done;
+  }
+  return out;
+}
+
+function ifMatchMatches(header: string, item: Item): boolean {
+  if (header === '*') return true;
+  return header.split(',').some((entry) => entry.trim() === etagOf(item));
+}
+
 export function patchItem(db: ItemDb, id: string, req: HttpRequest): HttpResponse {
-  return fail(501, 'not_implemented', 'PATCH is not implemented');
+  const stored = db.get(id);
+  if (!stored) return fail(404, 'not_found', `Item ${id} not found`);
+  const ifMatch = req.headers['if-match'];
+  if (ifMatch === undefined) return fail(428, 'precondition_required', 'If-Match header is required');
+  const patch = validatePatch(req.body);
+  if (!patch) return fail(422, 'invalid_patch', 'Title must be 1-40 characters');
+  if (!ifMatchMatches(ifMatch, stored)) return fail(412, 'version_conflict', 'Version conflict', stored);
+  const next: Item = {
+    ...stored,
+    ...(patch.title !== undefined ? { title: patch.title } : {}),
+    ...(patch.done !== undefined ? { done: patch.done } : {}),
+  };
+  const changed =
+    (patch.title !== undefined && patch.title !== stored.title) ||
+    (patch.done !== undefined && patch.done !== stored.done);
+  if (!changed) return ok(stored);
+  const updated: Item = { ...next, version: stored.version + 1 };
+  db.set(id, updated);
+  return ok(updated);
 }
