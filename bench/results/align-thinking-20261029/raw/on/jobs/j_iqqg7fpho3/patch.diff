diff --git a/src/validate.js b/src/validate.js
new file mode 100644
index 0000000..3d91994
--- /dev/null
+++ b/src/validate.js
@@ -0,0 +1,22 @@
+function capitalize(name) {
+  return name.charAt(0).toUpperCase() + name.slice(1);
+}
+
+export function validate(values, rules) {
+  const errors = {};
+  for (const [name, rule] of Object.entries(rules)) {
+    const text = values[name] == null ? '' : String(values[name]);
+    if (text.trim() === '') {
+      if (rule.required) errors[name] = `${capitalize(name)} is required`;
+      continue;
+    }
+    if (rule.pattern && !rule.pattern.test(text)) {
+      errors[name] = rule.message || `${capitalize(name)} has an invalid format`;
+      continue;
+    }
+    if (rule.minLength != null && text.length < rule.minLength) {
+      errors[name] = `${capitalize(name)} must be at least ${rule.minLength} characters`;
+    }
+  }
+  return errors;
+}
