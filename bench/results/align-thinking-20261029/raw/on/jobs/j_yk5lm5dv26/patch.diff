--- a/src/emitter.ts
+++ b/src/emitter.ts
@@ -8,16 +8,45 @@ type AnyFn = (...args: any[]) => void;
 export class Emitter<E extends EventMap> {
   private listeners = new Map<keyof E, Array<AnyFn>>();
 
-  on<K extends keyof E>(event: K, fn: (...args: E[K]) => void): void {
+  on<K extends keyof E>(event: K, fn: (...args: E[K]) => void): () => void {
     const list = this.listeners.get(event) ?? [];
     list.push(fn);
     this.listeners.set(event, list);
+    return () => this.off(event, fn);
+  }
+
+  off<K extends keyof E>(event: K, fn: (...args: E[K]) => void): void {
+    const list = this.listeners.get(event);
+    if (!list) return;
+    const i = list.indexOf(fn);
+    if (i !== -1) list.splice(i, 1);
+  }
+
+  once<K extends keyof E>(event: K, fn: (...args: E[K]) => void): () => void {
+    const wrapper: AnyFn = (...args: any[]) => {
+      this.off(event, wrapper);
+      fn(...(args as E[K]));
+    };
+    this.on(event, wrapper as (...args: E[K]) => void);
+    return () => this.off(event, wrapper);
+  }
+
+  listenerCount<K extends keyof E>(event: K): number {
+    return this.listeners.get(event)?.length ?? 0;
   }
 
   emit<K extends keyof E>(event: K, ...args: E[K]): boolean {
     const list = this.listeners.get(event);
     if (!list || list.length === 0) return false;
-    for (const fn of [...list]) fn(...args);
+    let error: unknown;
+    for (const fn of [...list]) {
+      try {
+        fn(...args);
+      } catch (err) {
+        if (error === undefined) error = err;
+      }
+    }
+    if (error !== undefined) throw error;
     return true;
   }
 }
