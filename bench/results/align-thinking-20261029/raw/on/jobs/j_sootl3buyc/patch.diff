+// Largest i with offsets[i] < y (a row whose top sits exactly on y is not visible).
+function findLastBefore(offsets, y) {
+  const count = offsets.length - 1;
+  let lo = 0;
+  let hi = count - 1;
+  while (lo < hi) {
+    const mid = (lo + hi + 1) >> 1;
+    if (offsets[mid] < y) lo = mid;
+    else hi = mid - 1;
+  }
+  return lo;
