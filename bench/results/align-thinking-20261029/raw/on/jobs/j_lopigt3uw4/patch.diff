diff --git a/src/server/patch.ts b/src/server/patch.ts
index 7a9b5b8..1e4de15 100644
--- a/src/server/patch.ts
+++ b/src/server/patch.ts
@@ -1,4 +1,4 @@
-import type { HttpRequest, HttpResponse, Item } from '../shared/types.ts';
+import type { HttpRequest, HttpResponse, Item, ItemPatch } from '../shared/types.ts';
 import { etagOf, fail, ok } from './etag.ts';
 
 export type ItemDb = Map<string, Item>;
@@ -19,6 +19,57 @@ const MAX_TITLE = 40;
  *                                      -> 200 with the stored item, version NOT bumped
  *  6. otherwise store the trimmed fields, bump version by 1 -> 200 with the new item and its new ETag.
  */
+function validatePatch(body: unknown): { patch: ItemPatch } | { message: string } {
+  if (typeof body !== 'object' || body === null || Array.isArray(body)) {
+    return { message: 'Patch must be an object' };
+  }
+  const o = body as Record<string, unknown>;
+  if (Object.keys(o).length === 0) return { message: 'Patch must contain at least one field' };
+  for (const key of Object.keys(o)) {
+    if (key !== 'title' && key !== 'done') return { message: `Unknown field "${key}"` };
+  }
+  const patch: ItemPatch = {};
+  if (o.title !== undefined) {
+    if (typeof o.title !== 'string') return { message: 'Title must be a string' };
+    const title = o.title.trim();
+    if (title.length < 1 || title.length > MAX_TITLE) return { message: 'Title must be 1-40 characters' };
+    patch.title = title;
+  }
+  if (o.done !== undefined) {
+    if (typeof o.done !== 'boolean') return { message: 'Done must be a boolean' };
+    patch.done = o.done;
+  }
+  return { patch };
+}
+
+/** True when any entry of the If-Match value matches the item's ETag ("*" matches anything). */
+function ifMatchMatches(ifMatch: string, item: Item): boolean {
+  if (ifMatch === '*') return true;
+  const etag = etagOf(item);
+  return ifMatch.split(',').some((entry) => entry.trim() === etag);
+}
+
 export function patchItem(db: ItemDb, id: string, req: HttpRequest): HttpResponse {
-  return fail(501, 'not_implemented', 'PATCH is not implemented');
+  const item = db.get(id);
+  if (!item) return fail(404, 'not_found', `Item ${id} not found`);
+
+  const ifMatch = req.headers['if-match'];
+  if (ifMatch === undefined) return fail(428, 'precondition_required', 'If-Match header is required');
+
+  const validated = validatePatch(req.body);
+  if ('message' in validated) return fail(422, 'invalid_patch', validated.message);
+
+  if (!ifMatchMatches(ifMatch, item)) {
+    return fail(412, 'version_conflict', 'Version conflict', item);
+  }
+
+  const { patch } = validated;
+  const changed =
+    (patch.title !== undefined && patch.title !== item.title) ||
+    (patch.done !== undefined && patch.done !== item.done);
+  if (!changed) return ok(item);
+
+  const next: Item = { ...item, ...patch, version: item.version + 1 };
+  db.set(id, next);
+  return ok(next);
 }
