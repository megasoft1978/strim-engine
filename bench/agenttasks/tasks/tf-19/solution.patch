diff --git a/Sources/Ledger/Account.swift b/Sources/Ledger/Account.swift
index f608b22..6fa7ffe 100644
--- a/Sources/Ledger/Account.swift
+++ b/Sources/Ledger/Account.swift
@@ -12,7 +12,7 @@ public struct Account {
     /// Rejects a transaction whose id is already posted.
     @discardableResult
     public mutating func post(_ t: Transaction) -> Bool {
-        if transactions.contains(where: { $0.memo == t.memo }) { return false }
+        if transactions.contains(where: { $0.id == t.id }) { return false }
         transactions.append(t)
         return true
     }
@@ -22,7 +22,7 @@ public struct Account {
     /// The transaction with the largest magnitude (earliest wins a tie).
     public func largest() -> Transaction? {
         var best: Transaction?
-        for t in transactions where best == nil || t.amount > best!.amount { best = t }
+        for t in transactions where best == nil || abs(t.amount.cents) > abs(best!.amount.cents) { best = t }
         return best
     }
 }
