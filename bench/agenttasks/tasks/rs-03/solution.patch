+    pub fn transpose(&self) -> Matrix {
+        let mut t = Matrix::zeros(self.cols, self.rows);
+        for r in 0..self.rows {
+            for c in 0..self.cols {
+                t.data[c * self.rows + r] = self.data[r * self.cols + c];
+            }
+        }
+        t
+    }
+
+    pub fn add(&self, other: &Matrix) -> Result<Matrix, ShapeError> {
+        if (self.rows, self.cols) != (other.rows, other.cols) {
+            return Err(ShapeError::Mismatch { left: (self.rows, self.cols), right: (other.rows, other.cols) });
+        }
+        let data = self.data.iter().zip(&other.data).map(|(a, b)| a + b).collect();
+        Ok(Matrix { rows: self.rows, cols: self.cols, data })
+    }
+
+    pub fn mul(&self, other: &Matrix) -> Result<Matrix, ShapeError> {
+        if self.cols != other.rows {
+            return Err(ShapeError::Mismatch { left: (self.rows, self.cols), right: (other.rows, other.cols) });
+        }
+        let mut out = Matrix::zeros(self.rows, other.cols);
+        for i in 0..self.rows {
+            for j in 0..other.cols {
+                let mut s = 0.0;
+                for k in 0..self.cols {
+                    s += self.data[i * self.cols + k] * other.data[k * other.cols + j];
+                }
+                out.data[i * other.cols + j] = s;
+            }
+        }
+        Ok(out)
+    }
+}
+
+impl fmt::Display for Matrix {
+    /// One bracketed line per row; every cell is right-aligned to the widest cell, one decimal.
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let cells: Vec<String> = self.data.iter().map(|v| format!("{:.1}", v)).collect();
+        let width = cells.iter().map(|c| c.len()).max().unwrap_or(0);
+        for r in 0..self.rows {
+            if r > 0 {
+                writeln!(f)?;
+            }
+            let row: Vec<String> = (0..self.cols).map(|c| format!("{:>w$}", cells[r * self.cols + c], w = width)).collect();
+            write!(f, "[{}]", row.join(" "))?;
+        }
+        Ok(())
+    }
 }
