diff --git b/src/validate.js b/src/validate.js
new file mode 100644
index 0000000..783ff71
--- /dev/null
+++ b/src/validate.js
@@ -0,0 +1,24 @@
+const titleCase = (s) => s.charAt(0).toUpperCase() + s.slice(1);
+
+/**
+ * rules: { field: { required?, minLength?, pattern?, message? } }.
+ * Returns { field: message } for the first failing rule of each field; {} when valid.
+ */
+export function validate(values, rules) {
+  const errors = {};
+  for (const [name, rule] of Object.entries(rules)) {
+    const label = titleCase(name);
+    const raw = values[name];
+    const value = typeof raw === 'string' ? raw.trim() : raw;
+    if (value === undefined || value === null || value === '') {
+      if (rule.required) errors[name] = `${label} is required`;
+      continue;
+    }
+    if (rule.minLength !== undefined && String(value).length < rule.minLength) {
+      errors[name] = `${label} must be at least ${rule.minLength} characters`;
+    } else if (rule.pattern && !rule.pattern.test(String(value))) {
+      errors[name] = rule.message || `${label} is invalid`;
+    }
+  }
+  return errors;
+}
