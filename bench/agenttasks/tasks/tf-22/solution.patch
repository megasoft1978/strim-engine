@@ -20,9 +20,14 @@ func Total(lines []Line, pct, bps int) int {
 // Fulfil removes every line from the stock or none of them. A shortage is
 // reported as an error wrapping ErrInsufficient and names the SKU.
 func Fulfil(s *Stock, lines []Line) error {
+	for _, l := range lines {
+		if s.Count(l.SKU) < l.Qty {
+			return fmt.Errorf("sku %s: %w", l.SKU, ErrInsufficient)
+		}
+	}
 	for _, l := range lines {
