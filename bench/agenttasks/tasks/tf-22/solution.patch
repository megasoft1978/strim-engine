+			return err
 		}
 	}
 	return nil
diff --git a/price.go b/price.go
index 302192e..af9086d 100644
--- a/price.go
+++ b/price.go
@@ -1,7 +1,7 @@
 package shop
 
 // Discount returns cents after a percent discount, rounded half up.
-func Discount(cents, pct int) int { return cents * (100 - pct) / 100 }
+func Discount(cents, pct int) int { return (cents*(100-pct) + 50) / 100 }
 
 // WithTax adds tax given in basis points (1 bp = 0.01%), rounded half up.
-func WithTax(cents, bps int) int { return cents + cents*bps/10000 }
+func WithTax(cents, bps int) int { return (cents*(10000+bps) + 5000) / 10000 }
diff --git a/stock.go b/stock.go
index 869e926..8231c99 100644
--- a/stock.go
+++ b/stock.go
@@ -15,10 +15,13 @@ func (s *Stock) Add(sku string, n int) { s.items[sku] += n }
 
 // Remove takes n units of sku. Removing exactly what is there is fine and drops the SKU.
 func (s *Stock) Remove(sku string, n int) error {
-	if s.items[sku] <= n {
+	if s.items[sku] < n {
 		return ErrInsufficient
 	}
 	s.items[sku] -= n
+	if s.items[sku] == 0 {
+		delete(s.items, sku)
+	}
 	return nil
 }
 
