 // held reports whether an explicit hold applies to a job.
 func (g *graph) held(id string, holds map[string]bool) bool {
+	seen := map[string]bool{}
+	queue := []string{id}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		if seen[current] {
+			continue
+		}
+		seen[current] = true
+		if holds[current] {
+			return true
+		}
+		queue = append(queue, g.parents[current]...)
+	}
 	return false
 }
--- a/pause.go
+++ b/pause.go
@@ -5,11 +5,23 @@
 // Explicit holds are independent: resuming one job does not remove another
 // hold. Unknown IDs return ErrUnknownJob.
 func (s *Scheduler) Pause(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.jobs[id]; !ok {
+		return ErrUnknownJob
+	}
+	s.holds[id] = true
 	return nil
 }
 
 // Resume removes only the explicit hold on id. Overdue work becomes eligible
 // immediately, subject to any remaining holds and dependency readiness.
 func (s *Scheduler) Resume(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.jobs[id]; !ok {
+		return ErrUnknownJob
+	}
+	delete(s.holds, id)
 	return nil
 }
