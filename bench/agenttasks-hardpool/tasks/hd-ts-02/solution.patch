index 5d5b8c7..3231884 100644
--- a/src/evaluate.ts
+++ b/src/evaluate.ts
@@ -1,13 +1,48 @@
-import type { Node, Rec } from "./types.ts";
-
-/**
- * Evaluates a Node against a record.
- * - field paths are dotted ("owner.name"); a missing path has no values.
- * - ":" matches when any scalar value of the field (array elements included) equals any wanted value, case-insensitively,
- *   comparing numbers and booleans by their string form. "!=" is the exact negation of ":" (so true for a missing field).
- * - < <= > >= compare only real numbers with a numeric right-hand side; anything else is false.
- * - a bare term matches when any top-level string value (or string element of a top-level array) contains it, case-insensitively.
- */
+import type { Node, Rec, Value } from "./types.ts";
+
+function lookup(rec: Rec, path: string): Value {
+  let cur: Value = rec;
+  for (const key of path.split(".")) {
+    if (cur === null || typeof cur !== "object" || Array.isArray(cur)) return undefined;
+    cur = cur[key];
+  }
+  return cur;
+}
+
+function scalars(v: Value): (string | number | boolean)[] {
+  if (Array.isArray(v)) return v.flatMap(scalars);
+  return typeof v === "string" || typeof v === "number" || typeof v === "boolean" ? [v] : [];
+}
+
+function equals(v: string | number | boolean, wanted: string): boolean {
+  return String(v).toLowerCase() === wanted.toLowerCase();
+}
+
+function numeric(s: string): number {
+  return s.trim() === "" ? NaN : Number(s);
+}
+
 export function evaluate(n: Node, rec: Rec): boolean {
-  throw new Error("not implemented");
+  switch (n.k) {
+    case "all": return true;
+    case "and": return evaluate(n.l, rec) && evaluate(n.r, rec);
+    case "or": return evaluate(n.l, rec) || evaluate(n.r, rec);
+    case "not": return !evaluate(n.e, rec);
+    case "term": {
+      const needle = n.text.toLowerCase();
+      return Object.values(rec).some((v) => scalars(v).some((s) => typeof s === "string" && s.toLowerCase().includes(needle)));
+    }
+    case "cmp": {
+      const vals = scalars(lookup(rec, n.field));
+      const hit = vals.some((v) => n.values.some((w) => equals(v, w)));
+      if (n.op === ":") return hit;
+      if (n.op === "!=") return !hit;
+      const rhs = numeric(n.values[0]);
+      return vals.some((v) => {
+        const lhs = typeof v === "number" ? v : NaN;
+        if (Number.isNaN(lhs) || Number.isNaN(rhs)) return false;
+        return n.op === "<" ? lhs < rhs : n.op === "<=" ? lhs <= rhs : n.op === ">" ? lhs > rhs : lhs >= rhs;
+      });
+    }
+  }
 }
