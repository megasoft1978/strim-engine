--- a/src/parser.ts
+++ b/src/parser.ts
@@ -1,12 +1,66 @@
-import type { Node } from "./types.ts";
-
-/**
- * Parses a query into a Node. Precedence, loosest to tightest: or, and (also implicit between adjacent terms), not.
- * An empty query is { k: "all" }. `word op word` is a cmp (an unquoted value splits on "," into values; a quoted value is one value),
- * a bare word is a term. Relational operators (< <= > >=) reject lists of more than one value.
- * Throws ParseError; pos is: the "(" for an unclosed group, the ")" for an unmatched one, the offending token otherwise,
- * and query.length when the query ends too early.
- */
+import { lex } from "./lexer.ts";
+import { ParseError } from "./types.ts";
+import type { Node, Token } from "./types.ts";
+
+/** Precedence, loosest to tightest: or, and (also implicit between adjacent terms), not. */
 export function parse(query: string): Node {
-  throw new Error("not implemented");
+  const toks = lex(query);
+  if (toks.length === 0) return { k: "all" };
+  let i = 0;
+  const peek = (): Token | undefined => toks[i];
+
+  function parseOr(): Node {
+    let l = parseAnd();
+    while (peek()?.t === "or") {
+      i++;
+      l = { k: "or", l, r: parseAnd() };
+    }
+    return l;
+  }
+
+  function parseAnd(): Node {
+    let l = parseNot();
+    for (;;) {
+      const t = peek();
+      if (!t || t.t === "or" || t.t === "rparen") return l;
+      if (t.t === "and") i++;
+      l = { k: "and", l, r: parseNot() };
+    }
+  }
+
+  function parseNot(): Node {
+    if (peek()?.t === "not") {
+      i++;
+      return { k: "not", e: parseNot() };
+    }
+    return parsePrimary();
+  }
+
+  function parsePrimary(): Node {
+    const t = peek();
+    if (!t) throw new ParseError("unexpected end of query", query.length);
+    i++;
+    if (t.t === "lparen") {
+      const e = parseOr();
+      const close = peek();
+      if (!close || close.t !== "rparen") throw new ParseError("missing ')'", t.pos);
+      i++;
+      return e;
+    }
+    if (t.t !== "word") throw new ParseError(`unexpected ${t.t === "op" ? t.op : t.t}`, t.pos);
+    const op = peek();
+    if (op?.t !== "op") return { k: "term", text: t.text };
+    i++;
+    const v = peek();
+    if (v?.t !== "word") throw new ParseError("missing value", v ? v.pos : query.length);
+    i++;
+    const values = v.quoted ? [v.text] : v.text.split(",");
+    if (op.op !== ":" && op.op !== "!=" && values.length > 1) throw new ParseError("list not allowed here", v.pos);
+    return { k: "cmp", field: t.text, op: op.op, values };
+  }
+
+  const ast = parseOr();
+  const rest = peek();
+  if (rest) throw new ParseError(rest.t === "rparen" ? "unmatched ')'" : "unexpected token", rest.pos);
+  return ast;
 }
