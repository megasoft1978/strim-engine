 export function lex(q: string): Token[] {
-  throw new Error("not implemented");
+  const out: Token[] = [];
+  let i = 0;
+  while (i < q.length) {
+    const c = q[i];
+    if (c === " " || c === "\t" || c === "\n") { i++; continue; }
+    if (c === "(") { out.push({ t: "lparen", pos: i++ }); continue; }
+    if (c === ")") { out.push({ t: "rparen", pos: i++ }); continue; }
+    if (c === ":") { out.push({ t: "op", op: ":", pos: i++ }); continue; }
+    if (c === "<" || c === ">") {
+      const eq = q[i + 1] === "=";
+      out.push({ t: "op", op: (c + (eq ? "=" : "")) as "<" | "<=" | ">" | ">=", pos: i });
+      i += eq ? 2 : 1;
+      continue;
+    }
+    if (c === "!" && q[i + 1] === "=") { out.push({ t: "op", op: "!=", pos: i }); i += 2; continue; }
+    if (c === '"') {
+      const start = i++;
+      let text = "";
+      while (i < q.length && q[i] !== '"') {
+        if (q[i] === "\\" && i + 1 < q.length) i++;
+        text += q[i++];
+      }
+      if (i >= q.length) throw new ParseError("unterminated string", start);
+      i++;
+      out.push({ t: "word", text, quoted: true, pos: start });
+      continue;
+    }
+    if (c === "!" || c === "=") throw new ParseError(`unexpected '${c}'`, i);
+    const start = i;
+    while (i < q.length && !STOP.has(q[i])) i++;
+    const text = q.slice(start, i);
+    const kw = text.toLowerCase();
+    if (kw === "and" || kw === "or" || kw === "not") out.push({ t: kw, pos: start });
+    else out.push({ t: "word", text, quoted: false, pos: start });
+  }
+  return out;
 }
