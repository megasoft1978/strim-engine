diff --git a/src/history.js b/src/history.js
index 234c56f..df26e5c 100644
--- a/src/history.js
+++ b/src/history.js
@@ -21,3 +21,17 @@ export function inverse(event) {
       throw new Error('event cannot be undone');
   }
 }
+
+// Rebuild both stacks from the same physical records used by projections.
+export function applyHistory(history, record) {
+  if (record.action === 'command') {
+    history.undo.push(record.event);
+    history.redo = [];
+  } else if (record.action === 'undo') {
+    history.redo.push(history.undo.pop());
+  } else if (record.action === 'redo') {
+    history.undo.push(history.redo.pop());
+  } else {
+    throw new Error('unknown history action');
+  }
+}
