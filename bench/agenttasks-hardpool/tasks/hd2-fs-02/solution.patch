diff --git a/src/server/patch.ts b/src/server/patch.ts
index 7a9b5b8..c016a80 100644
--- a/src/server/patch.ts
+++ b/src/server/patch.ts
@@ -20,5 +20,35 @@ const MAX_TITLE = 40;
  *  6. otherwise store the trimmed fields, bump version by 1 -> 200 with the new item and its new ETag.
  */
 export function patchItem(db: ItemDb, id: string, req: HttpRequest): HttpResponse {
-  return fail(501, 'not_implemented', 'PATCH is not implemented');
+  const item = db.get(id);
+  if (!item) return fail(404, 'not_found', `Item ${id} not found`);
+  const ifMatch = req.headers['if-match'];
+  if (ifMatch === undefined) return fail(428, 'precondition_required', 'If-Match header is required');
+
+  const body = req.body;
+  if (typeof body !== 'object' || body === null || Array.isArray(body)) return fail(422, 'invalid_patch', 'Patch must be an object');
+  const patch = body as Record<string, unknown>;
+  const keys = Object.keys(patch);
+  if (keys.length === 0 || keys.some((k) => k !== 'title' && k !== 'done')) {
+    return fail(422, 'invalid_patch', 'Patch must contain title and/or done');
+  }
+  let title: string | undefined;
+  if ('title' in patch) {
+    title = typeof patch.title === 'string' ? patch.title.trim() : '';
+    if (title.length === 0 || title.length > MAX_TITLE) return fail(422, 'invalid_patch', `Title must be 1-${MAX_TITLE} characters`);
+  }
+  if ('done' in patch && typeof patch.done !== 'boolean') return fail(422, 'invalid_patch', 'done must be a boolean');
+
+  const tags = ifMatch.split(',').map((t) => t.trim());
+  if (!tags.includes('*') && !tags.includes(etagOf(item))) {
+    return fail(412, 'version_conflict', `Item ${id} changed on the server`, item);
+  }
+
+  const next: Item = { ...item };
+  if (title !== undefined) next.title = title;
+  if (typeof patch.done === 'boolean') next.done = patch.done;
+  if (next.title === item.title && next.done === item.done) return ok(item);
+  next.version = item.version + 1;
+  db.set(id, next);
+  return ok(next);
 }
