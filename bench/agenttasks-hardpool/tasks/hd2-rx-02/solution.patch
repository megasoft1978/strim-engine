diff --git a/src/wizardReducer.js b/src/wizardReducer.js
index df6285c..7d6aa22 100644
--- a/src/wizardReducer.js
+++ b/src/wizardReducer.js
@@ -13,5 +13,32 @@ export const initialState = { step: 0, furthest: 0, values: {}, errors: {}, done
 //             Valid -> done: true, errors {}.
 // Once done, every action except `restart` is ignored. `restart` returns initialState.
 export function wizardReducer(state, action) {
-  throw new Error('not implemented');
+  if (action.type === 'restart') return initialState;
+  if (state.done) return state;
+  switch (action.type) {
+    case 'change': {
+      const { [action.field]: _removed, ...errors } = state.errors;
+      return { ...state, values: { ...state.values, [action.field]: action.value }, errors };
+    }
+    case 'next': {
+      if (state.step >= STEPS.length - 1) return state;
+      const errors = validateStep(STEPS[state.step].id, state.values);
+      if (Object.keys(errors).length > 0) return { ...state, errors };
+      const step = state.step + 1;
+      return { ...state, step, furthest: Math.max(state.furthest, step), errors: {} };
+    }
+    case 'back':
+      return state.step === 0 ? state : { ...state, step: state.step - 1, errors: {} };
+    case 'goto':
+      if (action.step === state.step || action.step < 0 || action.step > state.furthest) return state;
+      return { ...state, step: action.step, errors: {} };
+    case 'submit': {
+      if (state.step !== STEPS.length - 1) return state;
+      const bad = validateAll(state.values);
+      if (bad) return { ...state, step: bad.step, errors: bad.errors };
+      return { ...state, done: true, errors: {} };
+    }
+    default:
+      return state;
+  }
 }
