diff --git a/src/rules.js b/src/rules.js
index 49be980..3181fe5 100644
--- a/src/rules.js
+++ b/src/rules.js
@@ -1,3 +1,5 @@
+const COUPONS = { SAVE10: ['pro', 'team'], TEAM20: ['team'] };
+
 // Cross-field rules. Each one looks at several fields and reports on exactly one of them.
 //
 // crossFieldErrors(stepId, values, fieldErrors) -> { [field]: message }
@@ -14,5 +16,25 @@
 //            TEAM20 on pro -> "Coupon not valid for this plan"
 //            (no coupon rule runs while `plan` has an error or is empty)
 export function crossFieldErrors(stepId, values, fieldErrors = {}) {
-  throw new Error('not implemented');
+  const out = {};
+  if (stepId === 'account') {
+    const confirm = values.confirm || '';
+    if (!fieldErrors.confirm && confirm !== '' && confirm !== (values.password || '')) {
+      out.confirm = 'Passwords do not match';
+    }
+  }
+  if (stepId === 'plan') {
+    const plan = values.plan;
+    const age = String(values.age ?? '').trim();
+    if (!fieldErrors.plan && plan === 'team' && /^\d+$/.test(age) && Number(age) < 18) {
+      out.plan = 'Team plan requires age 18 or over';
+    }
+    const code = String(values.coupon || '').trim().toUpperCase();
+    if (!fieldErrors.plan && !fieldErrors.coupon && plan && code !== '') {
+      if (plan === 'free') out.coupon = 'Coupons need a paid plan';
+      else if (!COUPONS[code]) out.coupon = 'Unknown coupon';
+      else if (!COUPONS[code].includes(plan)) out.coupon = 'Coupon not valid for this plan';
+    }
+  }
+  return out;
 }
