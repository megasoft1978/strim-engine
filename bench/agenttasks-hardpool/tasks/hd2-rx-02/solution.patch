+    const check = checks[f.name];
+    const msg = check ? check(String(values[f.name] ?? '')) : null;
+    if (msg) errors[f.name] = msg;
+  }
+  return { ...crossFieldErrors(stepId, values, errors), ...errors };
 }
 
