+    return /^\d+$/.test(s) && Number(s) >= 13 && Number(s) <= 120 ? null : 'Age must be between 13 and 120';
+  },
+  plan: (v) => (Object.keys(PLANS).includes(v) ? null : 'Choose a plan'),
+  seats(v) {
+    const s = v.trim();
+    if (s === '') return 'Seats are required';
+    return /^\d+$/.test(s) && Number(s) >= 2 && Number(s) <= 50 ? null : 'Seats must be between 2 and 50';
+  },
+};
+
 export function validateStep(stepId, values) {
