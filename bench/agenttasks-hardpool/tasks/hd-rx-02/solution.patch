new file mode 100644
index 0000000..b9aa62f
--- /dev/null
+++ b/src/keys.js
@@ -0,0 +1,16 @@
+/** Index of the next enabled tab from `from` moving by `step` (+1 or -1), wrapping around; -1 if none. */
+export function stepIndex(tabs, from, step) {
+  const n = tabs.length;
+  for (let i = 1; i <= n; i++) {
+    const idx = (((from + step * i) % n) + n) % n;
+    if (!tabs[idx].disabled) return idx;
+  }
+  return -1;
+}
+
+/** Index of the first (or last) enabled tab; -1 if every tab is disabled. */
+export function edgeIndex(tabs, which) {
+  const order = tabs.map((_, i) => i);
+  if (which === 'last') order.reverse();
+  return order.find((i) => !tabs[i].disabled) ?? -1;
+}
diff --git a/fixed/src/tabsState.js b/src/tabsState.js
new file mode 100644
index 0000000..ced997a
--- /dev/null
+++ b/src/tabsState.js
@@ -0,0 +1,33 @@
+import { edgeIndex, stepIndex } from './keys.js';
+
+/** State is { tabs, active, focus }; active and focus are indexes into tabs, -1 when no tab is usable. */
+export function initTabs(tabs, requestedId) {
+  const wanted = tabs.findIndex((t) => t.id === requestedId && !t.disabled);
+  const idx = wanted >= 0 ? wanted : edgeIndex(tabs, 'first');
+  return { tabs, active: idx, focus: idx };
+}
+
+/** Pure reducer. No-op actions return the very same state object. */
+export function tabsReducer(state, action) {
+  const { tabs, active, focus } = state;
+  switch (action.type) {
+    case 'select': {
+      const idx = tabs.findIndex((t) => t.id === action.id);
+      if (idx < 0 || tabs[idx].disabled || (idx === active && idx === focus)) return state;
+      return { ...state, active: idx, focus: idx };
+    }
+    case 'move': {
+      let idx = -1;
+      if (action.to === 'next') idx = stepIndex(tabs, focus, 1);
+      else if (action.to === 'prev') idx = stepIndex(tabs, focus, -1);
+      else if (action.to === 'first' || action.to === 'last') idx = edgeIndex(tabs, action.to);
+      if (idx < 0 || idx === focus) return state;
+      return { ...state, focus: idx };
+    }
+    case 'activate':
+      if (focus < 0 || focus === active || tabs[focus].disabled) return state;
+      return { ...state, active: focus };
+    default:
+      return state;
+  }
+}
