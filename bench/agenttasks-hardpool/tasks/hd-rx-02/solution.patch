-export function Tabs({ tabs }) {
-  return <div className="tabs" />;
+import { Panel } from './Panel.jsx';
+import { Tab } from './Tab.jsx';
+import { initTabs } from './tabsState.js';
+
+export function Tabs({ tabs, id = 'tabs', activeId, keepMounted = false }) {
+  if (tabs.length === 0) return <p className="tabs-empty">No tabs</p>;
+  const { active } = initTabs(tabs, activeId);
+  return (
+    <div className="tabs">
+      <div role="tablist">
+        {tabs.map((t, i) => (
+          <Tab key={t.id} root={id} tab={t} selected={i === active} />
+        ))}
+      </div>
+      {tabs.map((t, i) =>
+        i === active || (keepMounted && !t.disabled) ? (
+          <Panel key={t.id} root={id} tab={t} selected={i === active} />
+        ) : null,
+      )}
+    </div>
+  );
 }
