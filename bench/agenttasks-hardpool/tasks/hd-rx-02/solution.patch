+import { panelId, tabId } from './ids.js';
+
+export function Panel({ root, tab, selected }) {
+  return (
+    <div
+      role="tabpanel"
+      id={panelId(root, tab)}
+      aria-labelledby={tabId(root, tab)}
+      hidden={selected ? undefined : true}
+      tabIndex={selected ? 0 : undefined}
+    >
+      {tab.content}
+    </div>
+  );
+}
diff --git a/fixed/src/Tab.jsx b/src/Tab.jsx
new file mode 100644
