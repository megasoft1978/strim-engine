--- /dev/null
+++ b/src/Tab.jsx
@@ -0,0 +1,20 @@
+import { panelId, tabId } from './ids.js';
+
+export function Tab({ root, tab, selected }) {
+  const count = tab.count > 0 ? <span className="count">{tab.count > 99 ? '99+' : tab.count}</span> : null;
+  return (
+    <button
+      type="button"
+      role="tab"
+      id={tabId(root, tab)}
+      aria-controls={panelId(root, tab)}
+      aria-selected={selected}
+      aria-disabled={tab.disabled ? 'true' : undefined}
+      disabled={tab.disabled}
+      tabIndex={selected ? 0 : -1}
+    >
+      {tab.label}
+      {count}
+    </button>
+  );
+}
